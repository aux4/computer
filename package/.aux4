          ],
          "help": {
            "text": "Print the computer-use method for agents (state, find, ocr, annotate, act, wait; background vs foreground; stop and log; data-loss warnings), followed by the current provider's platform notes",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "playbook:actions",
      "commands": [
        {
          "name": "computer",
          "private": true,
          "execute": [
            "cat ${packageDir}/actions/computer.yaml"
          ],
          "help": {
            "text": "Computer-use actions bound to the 'computer' playbook context (not loaded globally; see 'aux4 playbook execute')"
          }
        }
      ]
    }
  ]
}

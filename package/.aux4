{
  "scope": "aux4",
  "name": "computer",
  "version": "0.1.6",
  "description": "Computer-use for AI agents on any OS: one command surface (screenshot, find, click, type, windows, clipboard...) dispatched to the provider for this operating system, with a shared stop switch, action log, conformance suite and AI skill",
  "license": "Apache-2.0",
  "dependencies": [
    "aux4/playbook"
  ],
  "tags": [
    "aux4",
    "computer-use",
    "accessibility",
    "automation",
    "agent",
    "ai-skill",
    "macos",
    "linux",
    "windows"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "computer",
          "execute": [
            "profile:computer"
          ],
          "help": {
            "text": "Computer-use commands for AI agents."
          }
        },
        {
          "name": "ai",
          "execute": [
            "profile:ai"
          ],
          "help": {
            "text": "AI commands"
          }
        }
      ]
    },
    {
      "name": "computer",
      "commands": [
        {
          "name": "providers",
          "execute": [
            "${packageDir}/aux4-computer providers values(provider)"
          ],
          "help": {
            "text": "List the installed computer providers, their contract version, capabilities and which one this OS uses",
            "variables": [
              {
                "name": "provider",
                "text": "Also probe this provider name (beyond mac, linux and win)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "info",
          "execute": [
            "${packageDir}/aux4-computer dispatch info values(provider)"
          ],
          "help": {
            "text": "Describe the current provider: name, contract version, platform, version, capabilities, permissions",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "notes",
          "execute": [
            "${packageDir}/aux4-computer dispatch notes values(provider)"
          ],
          "help": {
            "text": "Print the current provider's platform notes for agents (markdown)",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "permissions",
          "execute": [
            "${packageDir}/aux4-computer dispatch permissions values(provider)"
          ],
          "help": {
            "text": "Check Accessibility and Screen Recording permission status",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "screenshot",
          "execute": [
            "${packageDir}/aux4-computer dispatch screenshot values(provider) params(output, display, app, maxWidth, annotate, roles, limit)"
          ],
          "help": {
            "text": "Capture a screenshot of a display or a specific app's window",
            "variables": [
              {
                "name": "output",
                "text": "File path to save the PNG to (defaults to a temp file)",
                "default": ""
              },
              {
                "name": "display",
                "text": "Display index to capture (from 'computer screen') (provider default: 0)",
                "default": ""
              },
              {
                "name": "app",
                "text": "Capture this app's front window (even when covered by other windows) instead of a display",
                "default": ""
              },
              {
                "name": "maxWidth",
                "text": "Resize down if wider than this, preserving aspect ratio (provider default: 1568)",
                "default": ""
              },
              {
                "name": "annotate",
                "text": "Draw a numbered box on each element (set-of-marks) and return the marks: number, ref, role, label, frame, center, windowCenter (provider default: false)",
                "default": "",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "roles",
                "text": "With --annotate: actionable (default: buttons, links, fields, checkboxes, menus, pop-ups, tabs, rows) or all (also text, images, headings, cells) (provider default: actionable)",
                "default": "",
                "options": [
                  "actionable",
                  "all"
                ]
              },
              {
                "name": "limit",
                "text": "With --annotate: most marks to draw (the rest are reported as truncated) (provider default: 150)",
                "default": ""
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "ocr",
          "execute": [
            "${packageDir}/aux4-computer dispatch ocr values(provider) params(app, image, text, level, languages, mode, scale, timeout)"
          ],
          "help": {
            "text": "Recognize text on the screen, an app's window or a PNG, with positions in click coordinates",
            "variables": [
              {
                "name": "app",
                "text": "Read this app's front window (even when covered by other windows); positions are also given relative to it as windowCenter, the space 'click --app' uses",
                "default": ""
              },
              {
                "name": "image",
                "text": "Recognize an existing PNG instead of capturing the screen (no Screen Recording permission needed)",
                "default": ""
              },
              {
                "name": "text",
                "text": "Only return lines containing this text (case-insensitive); each line also gets a 'match' with the position of just that text",
                "default": ""
              },
              {
                "name": "level",
                "text": "accurate (default) or fast recognition (provider default: accurate)",
                "default": "",
                "options": [
                  "accurate",
                  "fast"
                ]
              },
              {
                "name": "languages",
                "text": "Comma-separated recognition languages in priority order, e.g. en-US,pt-BR (default: the system's default)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): capture in the background, bringing the app to the front only if its window isn't on screen; background: never bring it forward (error instead); foreground: bring the app to the front for the capture, then restore (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "scale",
                "text": "With --image: image pixels per point (the 'scale' from 'screenshot'), so positions come out in points (provider default: 1)",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Give up with a JSON error after this long, e.g. 30s, 2m (default 60s: the first recognition after installing or updating takes about 30s) (provider default: 60s)",
                "default": ""
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "wait",
          "execute": [
            "${packageDir}/aux4-computer dispatch wait values(provider) params(text, role, app, gone, source, timeout, interval)"
          ],
          "help": {
            "text": "Wait until text, an element or an app window appears (or is gone), checking the accessibility tree first, then OCR",
            "variables": [
              {
                "name": "text",
                "text": "Text to wait for in element labels/values or on the pixels (ignores case, whitespace and commas, so 1792 matches 1,792)",
                "default": "",
                "arg": true
              },
              {
                "name": "role",
                "text": "Only elements with this role: the provider's native name or the mac name (AXButton, AXTextField...), accessibility only",
                "default": ""
              },
              {
                "name": "app",
                "text": "App to watch (defaults to the frontmost app / the whole screen); alone, wait until it is running with an on-screen window",
                "default": ""
              },
              {
                "name": "gone",
                "text": "true: wait until the text, element or app window is no longer there (provider default: false)",
                "default": "",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "source",
                "text": "auto (default): accessibility first, OCR of the app window (or screen) when accessibility has no match; ax (accessibility) or ocr: only that one (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "ax",
                  "ocr"
                ]
              },
              {
                "name": "timeout",
                "text": "How long to wait before failing, e.g. 500ms, 10s, 2m (provider default: 10s)",
                "default": ""
              },
              {
                "name": "interval",
                "text": "Pause between checks, e.g. 250ms, 1s (checks never overlap) (provider default: 500ms)",
                "default": ""
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "read",
          "execute": [
            "${packageDir}/aux4-computer dispatch read values(provider) params(app, depth)"
          ],
          "help": {
            "text": "Read the accessibility tree of the frontmost or named app",
            "variables": [
              {
                "name": "app",
                "text": "App name to read (defaults to the frontmost app)",
                "default": ""
              },
              {
                "name": "depth",
                "text": "Maximum tree depth to walk (provider default: 10)",
                "default": ""
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "find",
          "execute": [
            "${packageDir}/aux4-computer dispatch find values(provider) params(text, role, app)"
          ],
          "help": {
            "text": "Find UI elements by text and/or role",
            "variables": [
              {
                "name": "text",
                "text": "Text to search for in element label/value",
                "default": "",
                "arg": true
              },
              {
                "name": "role",
                "text": "Filter by role: the provider's native name or the mac name (AXButton, AXTextField, AXStaticText...)",
                "default": ""
              },
              {
                "name": "app",
                "text": "App to search (defaults to the frontmost app)",
                "default": ""
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "click",
          "execute": [
            "${packageDir}/aux4-computer dispatch click values(provider) params(x, y, button, count, element, app, mode)"
          ],
          "help": {
            "text": "Click at coordinates or press an element; in the background by default",
            "variables": [
              {
                "name": "x",
                "text": "X coordinate: relative to the app's window with --app (same as 'screenshot --app'), screen points without",
                "default": ""
              },
              {
                "name": "y",
                "text": "Y coordinate: relative to the app's window with --app (same as 'screenshot --app'), screen points without",
                "default": ""
              },
              {
                "name": "button",
                "text": "left or right (provider default: left)",
                "default": ""
              },
              {
                "name": "count",
                "text": "Click count (2 for double-click) (provider default: 1)",
                "default": ""
              },
              {
                "name": "element",
                "text": "Element ref from 'read'/'find' to press instead of x/y",
                "default": ""
              },
              {
                "name": "app",
                "text": "Target app; x/y become relative to its window (default: the frontmost app, screen points)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "move",
          "execute": [
            "${packageDir}/aux4-computer dispatch move values(provider) params(x, y)"
          ],
          "help": {
            "text": "Move the mouse cursor to screen coordinates (always real foreground)",
            "variables": [
              {
                "name": "x",
                "text": "X coordinate in screen points"
              },
              {
                "name": "y",
                "text": "Y coordinate in screen points"
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "drag",
          "execute": [
            "${packageDir}/aux4-computer dispatch drag values(provider) params(x, y, toX, toY)"
          ],
          "help": {
            "text": "Drag the mouse from one point to another (always real foreground)",
            "variables": [
              {
                "name": "x",
                "text": "Start X coordinate"
              },
              {
                "name": "y",
                "text": "Start Y coordinate"
              },
              {
                "name": "toX",
                "text": "End X coordinate"
              },
              {
                "name": "toY",
                "text": "End Y coordinate"
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "type",
          "execute": [
            "${packageDir}/aux4-computer dispatch type values(provider) params(text, delay, app, mode)"
          ],
          "help": {
            "text": "Type unicode-safe text into the focused element of an app; in the background by default",
            "variables": [
              {
                "name": "text",
                "text": "Text to type",
                "arg": true
              },
              {
                "name": "delay",
                "text": "Milliseconds to wait before typing (e.g. for a panel to appear) (provider default: 0)",
                "default": ""
              },
              {
                "name": "app",
                "text": "App to type into (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "shortcut",
          "execute": [
            "${packageDir}/aux4-computer dispatch shortcut values(provider) params(keys, delay, app, mode)"
          ],
          "help": {
            "text": "Press a keyboard shortcut, e.g. cmd+s on macOS, ctrl+s on Linux/Windows",
            "variables": [
              {
                "name": "keys",
                "text": "Key combo, e.g. 'cmd+c' (macOS), 'ctrl+c' (Linux/Windows), 'enter', 'escape'",
                "arg": true
              },
              {
                "name": "delay",
                "text": "Milliseconds to wait before pressing (provider default: 0)",
                "default": ""
              },
              {
                "name": "app",
                "text": "Send the shortcut to this app (background when possible); without it the shortcut is system-wide (real input)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "scroll",
          "execute": [
            "${packageDir}/aux4-computer dispatch scroll values(provider) params(x, y, dx, dy, app, mode)"
          ],
          "help": {
            "text": "Scroll at a position in an app; in the background by default",
            "variables": [
              {
                "name": "x",
                "text": "X coordinate to scroll at: relative to the app's window with --app, screen points without",
                "default": ""
              },
              {
                "name": "y",
                "text": "Y coordinate to scroll at: relative to the app's window with --app, screen points without",
                "default": ""
              },
              {
                "name": "dx",
                "text": "Horizontal scroll delta in pixels (provider default: 0)",
                "default": ""
              },
              {
                "name": "dy",
                "text": "Vertical scroll delta in pixels (provider default: 0)",
                "default": ""
              },
              {
                "name": "app",
                "text": "App to scroll (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "cursor",
          "execute": [
            "${packageDir}/aux4-computer dispatch cursor values(provider)"
          ],
          "help": {
            "text": "Get the current mouse cursor position",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "screen",
          "execute": [
            "${packageDir}/aux4-computer dispatch screen values(provider)"
          ],
          "help": {
            "text": "List displays with bounds and scale factor",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "apps",
          "execute": [
            "${packageDir}/aux4-computer dispatch apps values(provider)"
          ],
          "help": {
            "text": "List running applications",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "windows",
          "execute": [
            "${packageDir}/aux4-computer dispatch windows values(provider)"
          ],
          "help": {
            "text": "List on-screen windows",
            "variables": [
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "quit",
          "execute": [
            "${packageDir}/aux4-computer dispatch quit values(provider) params(app, force, timeout)"
          ],
          "help": {
            "text": "Quit an app (reports a 'save changes?' dialog instead of quitting); --force true kills it",
            "variables": [
              {
                "name": "app",
                "text": "Application name or platform id",
                "arg": true
              },
              {
                "name": "force",
                "text": "Force-quit (unsaved changes are lost; the desktop shell is refused) (provider default: false)",
                "default": "",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "timeout",
                "text": "How long to wait for the app to exit, e.g. 5s (provider default: 5s)",
                "default": ""
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "hide",
          "execute": [
            "${packageDir}/aux4-computer dispatch hide values(provider) params(app)"
          ],
          "help": {
            "text": "Hide an app (without activating anything)",
            "variables": [
              {
                "name": "app",
                "text": "Application name or platform id",
                "arg": true
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "unhide",
          "execute": [
            "${packageDir}/aux4-computer dispatch unhide values(provider) params(app)"
          ],
          "help": {
            "text": "Show a hidden app again without bringing it to the front",
            "variables": [
              {
                "name": "app",
                "text": "Application name or platform id",
                "arg": true
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "open",
          "execute": [
            "${packageDir}/aux4-computer dispatch open values(provider) params(app, mode, file, url, wait, hidden)"
          ],
          "help": {
            "text": "Open an app, a file or a URL without bringing anything to the front (by default); optionally wait for its window",
            "variables": [
              {
                "name": "app",
                "text": "Application name or platform id (macOS bundle id, Linux desktop id, Windows process/AppUserModelID); optional with --file/--url (their default app is used)",
                "default": "",
                "arg": true
              },
              {
                "name": "mode",
                "text": "auto (default): open without activating, put the frontmost app back if the app activates itself; background: same, error instead of bringing anything forward; foreground: open and activate the app (provider default: auto)",
                "default": "",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "file",
                "text": "File to open (in --app, or its default app)",
                "default": ""
              },
              {
                "name": "url",
                "text": "URL to open (in --app, or the default handler), e.g. https://aux4.io",
                "default": ""
              },
              {
                "name": "wait",
                "text": "Wait up to this long for the app's window (the file's window with --file) and return its frame, e.g. 10s",
                "default": ""
              },
              {
                "name": "hidden",
                "text": "Launch the app hidden (provider default: false)",
                "default": "",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "provider",
                "text": "Provider to use: mac, linux or win (default: the one for this operating system; env AUX4_COMPUTER_PROVIDER)",
                "env": "AUX4_COMPUTER_PROVIDER",
